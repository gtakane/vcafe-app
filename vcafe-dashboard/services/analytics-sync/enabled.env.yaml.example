# 本番読み取りを有効化する同期ジョブの環境変数テンプレート。
# このテンプレートをコピーして enabled.env.yaml を作り、Cloud Run Job に適用する。
# 重要: DRY_RUN は既定で "true" のまま。件数確認が済むまで BigQuery へは書き込まない。
#       実書き込みを行うのは、別レビューで DRY_RUN を "false" に変更してから。
# CUSTOMER_ID_HMAC_SECRET は env に直書きせず Secret Manager から注入する（deploy 時に --set-secrets）。
CONFIRM_READ_ONLY_SYNC: I_UNDERSTAND_THIS_READS_PRODUCTION
PRODUCTION_PROJECT_ID: v-athome-cafe-app
ANALYTICS_PROJECT_ID: vcafe-admin-analytics
BIGQUERY_DATASET: vcafe_analytics
BIGQUERY_LOCATION: asia-northeast1
SYNC_LOOKBACK_MINUTES: "90"
MAX_DOCUMENTS: "5000"
DRY_RUN: "true"
